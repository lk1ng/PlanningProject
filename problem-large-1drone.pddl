(define (problem drones)
    (:domain drones)
    (:objects
        depot1 depot2 charge-station1 charge-station2 charge-station3 site1 site2 site3 site4 site5 site6 - location
        comms1 - comms
        water1 - water
        medkit1 - medkit
        b0 b1 b2 b3 b4 b5 b6 - level
        drone1 - drone
    )
    (:init
        (= (total-cost) 0)
        ; define node relationships
        (accessible depot1) (accessible depot2) (accessible site2) (accessible site3) (accessible site4) (accessible site5)
        (accessible charge-station1) (accessible charge-station2) (accessible charge-station3)
        (connected depot1 site1) (connected site1 depot1) (flight-cost depot1 site1 b1) (flight-cost site1 depot1 b1)
        (connected site1 site2) (connected site2 site1) (flight-cost site2 site1 b1) (flight-cost site1 site2 b1)
        (connected site2 site3) (connected site3 site2) (flight-cost site2 site3 b1) (flight-cost site3 site2 b1)
        (connected site3 charge-station1) (connected charge-station1 site3) (flight-cost site3 charge-station1 b1) (flight-cost charge-station1 site3 b1)
        (connected site3 site4) (connected site4 site3) (flight-cost site4 site3 b2) (flight-cost site3 site4 b2)
        (connected site4 site5) (connected site5 site4) (flight-cost site4 site5 b2) (flight-cost site5 site4 b2)
        (connected site5 site6) (connected site6 site5) (flight-cost site5 site6 b1) (flight-cost site6 site5 b1)
        (connected site6 charge-station3) (connected charge-station3 site6) (flight-cost site6 charge-station3 b1) (flight-cost charge-station3 site6 b1)
        (connected site4 charge-station2) (connected charge-station2 site4) (flight-cost site4 charge-station2 b1) (flight-cost charge-station2 site4 b1)
        (connected depot2 site6) (connected site6 depot2) (flight-cost depot2 site6 b1) (flight-cost site6 depot2 b1)
        (= (distance depot1 site1) 1) (= (distance site1 depot1) 1)
        (= (distance site1 site2) 1) (= (distance site2 site1) 1)
        (= (distance site2 site3) 1) (= (distance site3 site2) 1)
        (= (distance site3 charge-station1) 1) (= (distance charge-station1 site3) 1)
        (= (distance site3 site4) 2) (= (distance site4 site3) 2)
        (= (distance site4 site5) 2) (= (distance site5 site4) 2)
        (= (distance site5 site6) 1) (= (distance site6 site5) 1)
        (= (distance site6 charge-station3) 1) (= (distance charge-station3 site6) 1)
        (= (distance site4 charge-station2) 1) (= (distance charge-station2 site4) 1)
        (= (distance depot2 site6) 1) (= (distance site6 depot2) 1)
        (is-charge-station charge-station1)
        (is-charge-station charge-station2)
        (is-charge-station charge-station3)
        ; configure unlocking - site6 unlocked by inspecting site3
        (unlocked-by-inspection site3 site6)
        (unlocked-by-delivery water1 site1)
        ; define missions
        (needs comms1 site6)
        (needs water1 site4)
        (needs medkit1 site1)
        ; define supply start locations
        (has-supply comms1 depot2)
        (has-supply water1 depot2)
        (has-supply medkit1 depot1)
        ; define maths
        (battery-after b6 b1 b5)
        (battery-after b5 b1 b4)
        (battery-after b4 b1 b3)
        (battery-after b3 b1 b2)
        (battery-after b2 b1 b1)
        (battery-after b1 b1 b0)
        (battery-after b6 b2 b4)
        (battery-after b5 b2 b3)
        (battery-after b4 b2 b2)
        (battery-after b3 b2 b1)
        (battery-after b2 b2 b0)
        (next-battery-level b0 b1)
        (next-battery-level b1 b2)
        (next-battery-level b2 b3)
        (next-battery-level b3 b4)
        (next-battery-level b4 b5)
        (next-battery-level b5 b6)
        (maximum-level b6)
        ; initial drone state
        (empty drone1)
        (battery drone1 b6)
        (at drone1 charge-station1)
    )
    (:goal (and
        (inspected site1) (inspected site2) (inspected site3) (inspected site4) (inspected site5) (inspected site6)
        (has-supply comms1 site6) (delivered comms1) (has-supply water1 site4) (delivered water1) 
        (has-supply medkit1 site1) (delivered medkit1) 
        (at drone1 depot1)
    ))
    (:metric minimize (total-cost))
)
